{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leinodev.github.io/munchkin/schema/card-set-v1.json",
  "title": "Munchkin original card set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "set_id",
    "version",
    "author",
    "license",
    "source",
    "content_digest",
    "cards"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "set_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "cards": {
      "type": "array",
      "minItems": 24,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "monster",
            "curse",
            "door",
            "treasure"
          ]
        },
        "combat_strength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "treasure_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "level_loss": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "rules_text": {
          "type": "string",
          "maxLength": 800
        },
        "flavor_text": {
          "type": "string",
          "maxLength": 300
        },
        "image": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9][A-Za-z0-9._/-]*\\.(avif|jpe?g|png|webp)$"
        },
        "alt_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "dependentRequired": {
        "image": [
          "alt_text"
        ],
        "alt_text": [
          "image"
        ]
      }
    }
  }
}
