{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leino.dev/schemas/leinoctl/profile-v1.json",
  "title": "leinoctl repository profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryId",
    "plans"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "componentsDir": {
      "$ref": "#/$defs/repoPath"
    },
    "generatorsFile": {
      "$ref": "#/$defs/repoPath"
    },
    "runtimeDir": {
      "$ref": "#/$defs/repoPath"
    },
    "plans": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeDir",
        "archiveDir"
      ],
      "properties": {
        "activeDir": {
          "$ref": "#/$defs/repoPath"
        },
        "archiveDir": {
          "$ref": "#/$defs/repoPath"
        }
      }
    },
    "composeFiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredExecutables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "minimumVersions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "versionProbes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeScripts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cwd",
        "argv"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "cwd": {
          "$ref": "#/$defs/repoPath"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    }
  }
}
