{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client",
      "vitest/globals"
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "test/**/*.ts",
    "*.ts",
    ".storybook/*.ts",
    "scripts/*.mjs"
  ]
}
