{
  "name": "@munchkin/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @munchkin/web dev",
    "build": "pnpm --filter @munchkin/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm test",
    "test:browser": "node test/run-playwright.mjs test",
    "test:a11y": "node test/run-playwright.mjs test a11y.spec.ts",
    "test:visual": "node test/run-playwright.mjs test visual.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "typescript": "catalog:"
  }
}
