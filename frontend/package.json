{
  "name": "@munchkin/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @munchkin/web dev",
    "build": "pnpm build:local && pnpm --filter @munchkin/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --workspace-concurrency=1 -r test",
    "check": "pnpm typecheck && pnpm test",
    "test:browser": "node test/run-playwright.mjs test --workers=1",
    "test:a11y": "node test/run-playwright.mjs test a11y.spec.ts --workers=1",
    "test:visual": "node test/run-playwright.mjs test visual.spec.ts --workers=1",
    "build:local": "pnpm --filter @munchkin/contracts build && pnpm --filter @munchkin/shared build && pnpm --filter @munchkin/api build && pnpm --filter @munchkin/components build:local",
    "storybook": "pnpm --filter @munchkin/components storybook",
    "build:storybook": "pnpm --filter @munchkin/components build:storybook"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "typescript": "catalog:",
    "@munchkin/contracts": "workspace:*"
  }
}
